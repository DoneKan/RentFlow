generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  type               String    @default("INDIVIDUAL")
  registrationNumber String?
  email              String?
  phone              String?
  address            String?
  city               String?
  country            String    @default("UG")
  currency           String    @default("UGX")
  logoUrl            String?
  plan               String    @default("FREE")
  planExpiresAt      DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users          User[]
  properties     Property[]
  vendors        Vendor[]
  prospects      Prospect[]
  inspections    Inspection[]
  budgets        Budget[]
  accounts       Account[]
  journalEntries JournalEntry[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  phone          String?
  role           String   @default("TENANT")
  organizationId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization?        @relation(fields: [organizationId], references: [id])
  managedProperties   Property[]           @relation("PropertyManager")
  ownedProperties     Property[]           @relation("PropertyOwner")
  tenantProfile       Tenancy[]            @relation("TenantUser")
  invoices            Invoice[]            @relation("TenantInvoices")
  payments            Payment[]            @relation("TenantPayments")
  notifications       Notification[]
  maintenanceRequests MaintenanceRequest[] @relation("TenantMaintenance")

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

model Property {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  type           String   @default("RESIDENTIAL")
  description    String?
  address        String
  city           String
  district       String?
  country        String   @default("UG")
  latitude       Float?
  longitude      Float?
  amenities      String   @default("[]")
  managerId      String
  ownerId        String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manager             User                 @relation("PropertyManager", fields: [managerId], references: [id])
  owner               User?                @relation("PropertyOwner", fields: [ownerId], references: [id])
  organization        Organization         @relation(fields: [organizationId], references: [id])
  units               Unit[]
  expenses            Expense[]
  tenancies           Tenancy[]
  invoices            Invoice[]
  maintenanceRequests MaintenanceRequest[]
  inspections         Inspection[]
  prospects           Prospect[]
  budgets             Budget[]

  @@index([organizationId])
  @@index([code])
  @@index([ownerId])
  @@map("properties")
}

model Unit {
  id                String   @id @default(cuid())
  propertyId        String
  unitNumber        String
  floor             Int?
  type              String   @default("1-bedroom")
  bedrooms          Int      @default(1)
  bathrooms         Int      @default(1)
  squareMeters      Float?
  rentAmount        Decimal
  currency          String   @default("UGX")
  additionalCharges String   @default("{}")
  paymentPeriod     String   @default("MONTHLY")
  status            String   @default("VACANT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  property            Property             @relation(fields: [propertyId], references: [id])
  tenancy             Tenancy?
  invoices            Invoice[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@index([status])
  @@map("units")
}

model Tenancy {
  id            String    @id @default(cuid())
  unitId        String    @unique
  tenantId      String
  propertyId    String
  startDate     DateTime
  endDate       DateTime?
  rentAmount    Decimal
  depositAmount Decimal   @default(0)
  status        String    @default("ACTIVE")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  unit                Unit                 @relation(fields: [unitId], references: [id])
  tenant              User                 @relation("TenantUser", fields: [tenantId], references: [id])
  property            Property             @relation(fields: [propertyId], references: [id])
  invoices            Invoice[]
  maintenanceRequests MaintenanceRequest[]
  leaseDocuments      LeaseDocument[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@map("tenancies")
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  tenancyId     String
  unitId        String
  propertyId    String
  tenantId      String
  amount        Decimal
  currency      String    @default("UGX")
  dueDate       DateTime
  items         String
  latePenalty   Decimal   @default(0)
  status        String    @default("DRAFT")
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenancy  Tenancy   @relation(fields: [tenancyId], references: [id])
  unit     Unit      @relation(fields: [unitId], references: [id])
  property Property  @relation(fields: [propertyId], references: [id])
  tenant   User      @relation("TenantInvoices", fields: [tenantId], references: [id])
  payments Payment[]

  @@index([tenancyId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id            String    @id @default(cuid())
  invoiceId     String
  tenantId      String
  amount        Decimal
  currency      String    @default("UGX")
  method        String
  transactionId String?
  mobileNumber  String?
  status        String    @default("PENDING")
  receiptNumber String    @unique
  receiptUrl    String?
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  tenant  User    @relation("TenantPayments", fields: [tenantId], references: [id])

  @@index([invoiceId])
  @@index([tenantId])
  @@index([status])
  @@map("payments")
}

model Expense {
  id          String   @id @default(cuid())
  propertyId  String
  category    String   @default("OTHER")
  amount      Decimal
  currency    String   @default("UGX")
  description String
  date        DateTime
  receiptUrl  String?
  vendor      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([category])
  @@index([date])
  @@map("expenses")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model MaintenanceRequest {
  id          String    @id @default(cuid())
  tenancyId   String
  unitId      String
  propertyId  String
  tenantId    String
  title       String
  description String
  priority    String    @default("MEDIUM")
  status      String    @default("OPEN")
  vendorId    String?
  assignedAt  DateTime?
  cost        Decimal?
  vendorNotes String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenancy  Tenancy  @relation(fields: [tenancyId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  tenant   User     @relation("TenantMaintenance", fields: [tenantId], references: [id])
  vendor   Vendor?  @relation(fields: [vendorId], references: [id])

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@index([vendorId])
  @@map("maintenance_requests")
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String   @default("GENERAL")
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  maintenanceRequests MaintenanceRequest[]

  @@index([organizationId])
  @@map("vendors")
}

model LeaseDocument {
  id               String    @id @default(cuid())
  tenancyId        String
  fileUrl          String?
  status           String    @default("DRAFT")
  signatureDataUrl String?
  signerName       String?
  signerIp         String?
  signedAt         DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenancy Tenancy @relation(fields: [tenancyId], references: [id])

  @@index([tenancyId])
  @@index([status])
  @@map("lease_documents")
}

model Prospect {
  id                    String    @id @default(cuid())
  organizationId        String
  propertyId            String?
  unitId                String?
  name                  String
  phone                 String
  email                 String?
  source                String    @default("OTHER")
  stage                 String    @default("NEW")
  showingDate           DateTime?
  idNumber              String?
  employerName          String?
  monthlyIncome         Decimal?
  previousLandlordName  String?
  previousLandlordPhone String?
  references            String?   @default("[]")
  screeningStatus       String    @default("NOT_STARTED")
  screeningNotes        String?
  screenedById          String?
  screenedAt            DateTime?
  convertedTenancyId    String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property?    @relation(fields: [propertyId], references: [id])

  @@index([organizationId])
  @@index([propertyId])
  @@index([stage])
  @@map("prospects")
}

model Inspection {
  id             String    @id @default(cuid())
  organizationId String
  propertyId     String
  unitId         String?
  tenancyId      String?
  type           String    @default("ROUTINE")
  status         String    @default("SCHEDULED")
  scheduledDate  DateTime?
  completedDate  DateTime?
  inspectorId    String?
  overallNotes   String?
  reportUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  property     Property         @relation(fields: [propertyId], references: [id])
  items        InspectionItem[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([tenancyId])
  @@index([status])
  @@map("inspections")
}

model InspectionItem {
  id           String   @id @default(cuid())
  inspectionId String
  area         String
  condition    String   @default("GOOD")
  notes        String?
  createdAt    DateTime @default(now())

  inspection Inspection        @relation(fields: [inspectionId], references: [id])
  photos     InspectionPhoto[]

  @@index([inspectionId])
  @@map("inspection_items")
}

model InspectionPhoto {
  id               String   @id @default(cuid())
  inspectionItemId String
  url              String
  caption          String?
  createdAt        DateTime @default(now())

  item InspectionItem @relation(fields: [inspectionItemId], references: [id])

  @@index([inspectionItemId])
  @@map("inspection_photos")
}

model Budget {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String?
  name           String
  periodStart    DateTime
  periodEnd      DateTime
  currency       String   @default("UGX")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property?    @relation(fields: [propertyId], references: [id])
  lines        BudgetLine[]

  @@index([organizationId])
  @@index([propertyId])
  @@map("budgets")
}

model BudgetLine {
  id            String   @id @default(cuid())
  budgetId      String
  category      String
  plannedAmount Decimal
  notes         String?
  createdAt     DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id])

  @@index([budgetId])
  @@map("budget_lines")
}

model Account {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  lines        JournalLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("accounts")
}

model JournalEntry {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @default(now())
  memo           String?
  reference      String?
  sourceType     String   @default("MANUAL")
  sourceId       String?
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  lines        JournalLine[]

  @@index([organizationId])
  @@index([date])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  propertyId     String?
  debit          Decimal @default(0)
  credit         Decimal @default(0)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}
