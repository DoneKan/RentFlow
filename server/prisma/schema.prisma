generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  type               String    @default("INDIVIDUAL")
  registrationNumber String?
  email              String?
  phone              String?
  address            String?
  city               String?
  country            String    @default("UG")
  currency           String    @default("UGX")
  logoUrl            String?
  plan               String    @default("FREE")
  planExpiresAt      DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users          User[]
  properties     Property[]
  vendors        Vendor[]
  prospects      Prospect[]
  inspections    Inspection[]
  budgets        Budget[]
  accounts       Account[]
  journalEntries JournalEntry[]
  importBatches  ImportBatch[]
  landlordExpenseReminders LandlordExpenseReminder[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  // Nullable: tenants are commonly entered with only a phone number (SMS is
  // the reliable channel; many landlords never collect a per-tenant email).
  // Still @unique — Postgres treats every NULL as distinct under a unique
  // constraint, so any number of email-less users can coexist. Staff/owner
  // accounts still require an email at the Joi-validation layer (their auth
  // route), since email+password is still their only login method — a
  // tenant with no email simply has no portal login, which is fine since
  // SMS/PDF-download cover their needs without one.
  email          String?  @unique
  password       String
  name           String
  phone          String?
  role           String   @default("TENANT")
  organizationId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization?         @relation(fields: [organizationId], references: [id])
  managedProperties    Property[]            @relation("PropertyManager")
  ownedProperties      Property[]            @relation("PropertyOwner")
  tenantProfile        Tenancy[]             @relation("TenantUser")
  invoices             Invoice[]             @relation("TenantInvoices")
  payments             Payment[]             @relation("TenantPayments")
  notifications        Notification[]
  maintenanceRequests  MaintenanceRequest[]  @relation("TenantMaintenance")
  passwordResetTokens  PasswordResetToken[]
  importBatches        ImportBatch[]
  landlordExpenseReminders LandlordExpenseReminder[]

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

// The raw reset token is only ever emailed to the user — this table stores
// a SHA-256 hash of it, never the token itself, same principle as never
// storing a plaintext password. usedAt makes a token single-use; expiresAt
// makes it time-limited.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model Property {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  type           String   @default("RESIDENTIAL")
  description    String?
  address        String
  city           String
  district       String?
  country        String   @default("UG")
  latitude       Float?
  longitude      Float?
  amenities      String   @default("[]")
  managerId      String
  ownerId        String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manager             User                 @relation("PropertyManager", fields: [managerId], references: [id])
  owner               User?                @relation("PropertyOwner", fields: [ownerId], references: [id])
  organization        Organization         @relation(fields: [organizationId], references: [id])
  units               Unit[]
  expenses            Expense[]
  tenancies           Tenancy[]
  invoices            Invoice[]
  maintenanceRequests MaintenanceRequest[]
  inspections         Inspection[]
  prospects           Prospect[]
  budgets             Budget[]
  landlordExpenseReminders LandlordExpenseReminder[]

  @@index([organizationId])
  @@index([code])
  @@index([ownerId])
  @@map("properties")
}

model Unit {
  id                String   @id @default(cuid())
  propertyId        String
  unitNumber        String
  floor             Int?
  type              String   @default("1-bedroom")
  bedrooms          Int      @default(1)
  bathrooms         Int      @default(1)
  squareMeters      Float?
  rentAmount        Decimal
  currency          String   @default("UGX")
  additionalCharges String   @default("{}")
  paymentPeriod     String   @default("MONTHLY")
  status            String   @default("VACANT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  property            Property             @relation(fields: [propertyId], references: [id])
  tenancies           Tenancy[]
  invoices            Invoice[]
  maintenanceRequests MaintenanceRequest[]
  expenses            Expense[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@index([status])
  @@map("units")
}

model Tenancy {
  id            String    @id @default(cuid())
  unitId        String
  tenantId      String
  propertyId    String
  startDate     DateTime
  endDate       DateTime?
  rentAmount    Decimal
  depositAmount Decimal   @default(0)
  status        String    @default("ACTIVE")
  notes         String?
  // Per-tenancy contact snapshot, deliberately separate from the linked
  // User's own name/phone. The linked User is a login account, and one
  // account (one email) can be reused across multiple Tenancy rows when an
  // org doesn't collect a distinct email per tenant — so the account's own
  // name/phone can't double as "this tenancy's tenant display info" without
  // every tenancy sharing that account aliasing to the same values. This is
  // what every "tenant name" read/write should use instead of tenant.name.
  tenantName    String
  tenantPhone   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  unit                Unit                 @relation(fields: [unitId], references: [id])
  tenant              User                 @relation("TenantUser", fields: [tenantId], references: [id])
  property            Property             @relation(fields: [propertyId], references: [id])
  invoices            Invoice[]
  maintenanceRequests MaintenanceRequest[]
  leaseDocuments      LeaseDocument[]

  @@index([unitId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@map("tenancies")
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  tenancyId     String
  unitId        String
  propertyId    String
  tenantId      String
  amount        Decimal
  currency      String    @default("UGX")
  dueDate       DateTime
  items         String
  latePenalty   Decimal   @default(0)
  notes         String?
  status        String    @default("DRAFT")
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Set only by the recurring-invoice job, to "YYYY-MM" of the billing
  // month — the (tenancyId, billingPeriod) unique constraint below is what
  // makes that job idempotent even under concurrent/duplicate runs. Left
  // null on manually-created invoices, which never collide with each other
  // since SQL treats every NULL as distinct under a unique constraint.
  billingPeriod String?
  // Snapshot, taken when this draft was auto-generated, of the tenant's
  // other outstanding (SENT/OVERDUE) balance at that moment — so a
  // generated draft surfaces "they're behind" instead of silently
  // producing another invoice next to an unpaid one.
  priorUnpaidAmount Decimal @default(0)

  tenancy  Tenancy   @relation(fields: [tenancyId], references: [id])
  unit     Unit      @relation(fields: [unitId], references: [id])
  property Property  @relation(fields: [propertyId], references: [id])
  tenant   User      @relation("TenantInvoices", fields: [tenantId], references: [id])
  payments Payment[]

  @@unique([tenancyId, billingPeriod])
  @@index([tenancyId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id            String    @id @default(cuid())
  invoiceId     String
  tenantId      String
  amount        Decimal
  currency      String    @default("UGX")
  method        String
  transactionId String?
  mobileNumber  String?
  status        String    @default("PENDING")
  receiptNumber String    @unique
  receiptUrl    String?
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  tenant  User    @relation("TenantPayments", fields: [tenantId], references: [id])

  @@index([invoiceId])
  @@index([tenantId])
  @@index([status])
  @@map("payments")
}

model Expense {
  id          String   @id @default(cuid())
  propertyId  String
  unitId      String?
  category    String   @default("OTHER")
  amount      Decimal
  currency    String   @default("UGX")
  description String
  date        DateTime
  receiptUrl  String?
  vendor      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  unit     Unit?    @relation(fields: [unitId], references: [id])

  @@index([propertyId])
  @@index([unitId])
  @@index([category])
  @@index([date])
  @@map("expenses")
}

// A landlord's own recurring cost (URA rental tax, council fees, askari
// wages, ...) — deliberately separate from Expense/Invoice/Payment/Tenancy.
// This is a reminder schedule, not a record of money actually spent: no FK
// to any tenant-billing entity, and creating/editing one never touches an
// Expense row. When an actual payment is made against one of these, that
// still gets logged as a normal Expense the existing way — this model only
// tracks "when is the next one due" and "have we reminded for it yet".
model LandlordExpenseReminder {
  id                     String    @id @default(cuid())
  organizationId         String
  propertyId             String?
  name                   String
  description            String?
  amount                 Decimal
  // MONTHLY | ANNUAL | CUSTOM — CUSTOM uses customIntervalDays below.
  recurrenceType         String
  customIntervalDays     Int?
  // Fixed reference point recurrence is always computed from — never
  // mutated by the daily rollover, only by a deliberate reschedule (see
  // controller update()). Every occurrence is anchorDate + N periods,
  // computed fresh from this same anchor each time, the same principle
  // invoiceJob.js's addMonthsFromAnchor uses for tenancy billing: compute
  // from the ORIGINAL anchor every time, never from a previously-computed
  // occurrence, so a reminder anchored on the 31st doesn't permanently
  // drift to the 3rd the first time it crosses a 28-day February.
  anchorDate             DateTime
  nextDueDate            DateTime
  // How many days before nextDueDate to notify — a heads-up before the
  // cost is due, not an after-the-fact overdue notice like the tenant
  // invoice reminder.
  remindDaysBefore       Int       @default(7)
  // Set to the nextDueDate value a reminder was actually sent for, so the
  // daily job can tell "already reminded for this occurrence" apart from
  // "this is a new occurrence" without a separate log table. Cleared back
  // to null whenever nextDueDate rolls forward.
  lastReminderForDueDate DateTime?
  isActive               Boolean   @default(true)
  createdById            String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property?    @relation(fields: [propertyId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([nextDueDate])
  @@map("landlord_expense_reminders")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model MaintenanceRequest {
  id          String    @id @default(cuid())
  tenancyId   String
  unitId      String
  propertyId  String
  tenantId    String
  title       String
  description String
  priority    String    @default("MEDIUM")
  status      String    @default("OPEN")
  vendorId    String?
  assignedAt  DateTime?
  cost        Decimal?
  vendorNotes String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenancy  Tenancy  @relation(fields: [tenancyId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  tenant   User     @relation("TenantMaintenance", fields: [tenantId], references: [id])
  vendor   Vendor?  @relation(fields: [vendorId], references: [id])

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@index([vendorId])
  @@map("maintenance_requests")
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String   @default("GENERAL")
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  maintenanceRequests MaintenanceRequest[]

  @@index([organizationId])
  @@map("vendors")
}

model LeaseDocument {
  id               String    @id @default(cuid())
  tenancyId        String
  fileUrl          String?
  status           String    @default("DRAFT")
  signatureDataUrl String?
  signerName       String?
  signerIp         String?
  signedAt         DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenancy Tenancy @relation(fields: [tenancyId], references: [id])

  @@index([tenancyId])
  @@index([status])
  @@map("lease_documents")
}

model Prospect {
  id                    String    @id @default(cuid())
  organizationId        String
  propertyId            String?
  unitId                String?
  name                  String
  phone                 String
  email                 String?
  source                String    @default("OTHER")
  stage                 String    @default("NEW")
  showingDate           DateTime?
  idNumber              String?
  employerName          String?
  monthlyIncome         Decimal?
  previousLandlordName  String?
  previousLandlordPhone String?
  references            String?   @default("[]")
  screeningStatus       String    @default("NOT_STARTED")
  screeningNotes        String?
  screenedById          String?
  screenedAt            DateTime?
  convertedTenancyId    String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property?    @relation(fields: [propertyId], references: [id])

  @@index([organizationId])
  @@index([propertyId])
  @@index([stage])
  @@map("prospects")
}

model Inspection {
  id             String    @id @default(cuid())
  organizationId String
  propertyId     String
  unitId         String?
  tenancyId      String?
  type           String    @default("ROUTINE")
  status         String    @default("SCHEDULED")
  scheduledDate  DateTime?
  completedDate  DateTime?
  inspectorId    String?
  overallNotes   String?
  reportUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  property     Property         @relation(fields: [propertyId], references: [id])
  items        InspectionItem[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([tenancyId])
  @@index([status])
  @@map("inspections")
}

model InspectionItem {
  id           String   @id @default(cuid())
  inspectionId String
  area         String
  condition    String   @default("GOOD")
  notes        String?
  createdAt    DateTime @default(now())

  inspection Inspection        @relation(fields: [inspectionId], references: [id])
  photos     InspectionPhoto[]

  @@index([inspectionId])
  @@map("inspection_items")
}

model InspectionPhoto {
  id               String   @id @default(cuid())
  inspectionItemId String
  url              String
  caption          String?
  createdAt        DateTime @default(now())

  item InspectionItem @relation(fields: [inspectionItemId], references: [id])

  @@index([inspectionItemId])
  @@map("inspection_photos")
}

model Budget {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String?
  name           String
  periodStart    DateTime
  periodEnd      DateTime
  currency       String   @default("UGX")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property?    @relation(fields: [propertyId], references: [id])
  lines        BudgetLine[]

  @@index([organizationId])
  @@index([propertyId])
  @@map("budgets")
}

model BudgetLine {
  id            String   @id @default(cuid())
  budgetId      String
  category      String
  plannedAmount Decimal
  notes         String?
  createdAt     DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id])

  @@index([budgetId])
  @@map("budget_lines")
}

model Account {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  lines        JournalLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("accounts")
}

model JournalEntry {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @default(now())
  memo           String?
  reference      String?
  sourceType     String   @default("MANUAL")
  sourceId       String?
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  lines        JournalLine[]

  @@index([organizationId])
  @@index([date])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  propertyId     String?
  debit          Decimal @default(0)
  credit         Decimal @default(0)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([propertyId])
  @@map("journal_lines")
}

// A single upload's dry-run + commit lifecycle. entityType is a plain string
// ("PROPERTY", "UNIT", "TENANCY", "INVOICE", "EXPENSE") rather than a Prisma
// enum, matching how the rest of this schema treats status/category fields —
// see DEVELOPMENT.md. A batch moves PENDING -> COMMITTED (rows written,
// one-way — confirming twice is rejected) or PENDING -> FAILED (transaction
// rolled back, nothing written). Rows and their per-row validation outcome
// are kept (ImportBatchRow) so re-confirming or downloading the error report
// doesn't require re-parsing/re-validating the original file.
model ImportBatch {
  id             String    @id @default(cuid())
  organizationId String
  entityType     String
  fileName       String
  status         String    @default("PENDING")
  totalRows      Int
  cleanCount     Int
  warningCount   Int
  errorCount     Int
  importedCount  Int       @default(0)
  failureReason  String?
  createdById    String
  createdAt      DateTime  @default(now())
  committedAt    DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id])
  createdBy    User             @relation(fields: [createdById], references: [id])
  rows         ImportBatchRow[]

  @@index([organizationId])
  @@index([status])
  @@map("import_batches")
}

model ImportBatchRow {
  id        String  @id @default(cuid())
  batchId   String
  rowNumber Int
  // JSON-stringified normalized field values for this row (SQLite/Postgres
  // portability — same reasoning as Property.amenities elsewhere in this file).
  data      String
  bucket    String
  // JSON-stringified array of plain-language reason strings.
  reasons   String  @default("[]")
  // Only meaningful for bucket=WARNING: whether the user opted to import this
  // row despite the warning. Defaults false so a re-uploaded file that now
  // collides with already-imported data does NOT get re-imported unless the
  // user explicitly overrides it.
  included  Boolean @default(false)
  imported  Boolean @default(false)

  batch ImportBatch @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([batchId, bucket])
  @@map("import_batch_rows")
}
